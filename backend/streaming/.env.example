# Streaming Server Config
STREAM_PORT=3001          # Socket.IO + REST API port
RTMP_PORT=1935            # OBS connects here
HTTP_PORT=8000            # HLS stream served here

# Security — OBS stream key validation
STREAM_SECRET=festiva_stream_secret_2024

# MongoDB — same as main backend
MONGO_URI=mongodb://localhost:27017/festiva

# Main backend URL (to update event status)
BACKEND_URL=http://localhost:5000

# JWT (same as main backend)
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# FFmpeg path (Windows example — change for your OS)
# Windows: C:/ffmpeg/bin/ffmpeg.exe
# Linux/Mac: /usr/bin/ffmpeg
FFMPEG_PATH=/usr/bin/ffmpeg

# Where HLS files are saved
HLS_PATH=./media/live
RECORDINGS_PATH=./media/recordings

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:3000
